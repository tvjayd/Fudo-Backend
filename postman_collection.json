						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Jane Smith\",\n    \"email\": \"jane.smith@example.com\",\n    \"password\": \"password123\",\n    \"password_confirmation\": \"password123\",\n    \"age\": 28,\n    \"weight\": 65.5,\n    \"height\": 165.0,\n    \"gender\": \"female\",\n    \"fitness_plan\": \"weight_loss\",\n    \"disease\": \"None\",\n    \"lifestyle\": \"Moderately active\",\n    \"allergies\": \"Dairy, Gluten\",\n    \"workout_type\": \"gym\",\n    \"workout_intense_type\": \"Moderate\",\n    \"workout_time\": \"45 minutes\",\n    \"meal_type\": \"veg\",\n    \"type_of_test\": \"Weight Loss Diet\",\n    \"ingredients\": [\"chicken\", \"rice\", \"broccoli\", \"spinach\"],\n    \"ingredient_category\": \"veggies\",\n    \"food_preparation_materials\": [\"olive oil\", \"turmeric\", \"garlic\", \"ginger\"],\n    \"bread_type\": \"Whole wheat\",\n    \"rice_type\": \"Brown rice\",\n    \"sprouts_material\": [\"mung beans\", \"chickpeas\", \"lentils\"]\n}"
						},
